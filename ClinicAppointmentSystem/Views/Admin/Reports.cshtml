@{
    ViewData["Title"] = "Reports & Analytics";
    var appointmentsBySpecialization = ViewBag.AppointmentsBySpecialization as IEnumerable<dynamic>;
    var topDoctors = ViewBag.TopDoctors as IEnumerable<dynamic>;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-bar-chart me-2"></i>Reports & Analytics</h2>
            <p class="text-muted mb-0">View clinic performance metrics and statistics</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Revenue Card -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body py-4">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                <i class="bi bi-currency-dollar fs-1"></i>
                            </div>
                        </div>
                        <div class="col">
                            <h6 class="text-white-50 mb-1">Total Revenue (Completed Appointments)</h6>
                            <h2 class="mb-0">$@(ViewBag.TotalRevenue?.ToString("N2") ?? "0.00")</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Appointments by Specialization -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Appointments by Specialization</h5>
                </div>
                <div class="card-body">
                    @if (appointmentsBySpecialization != null && appointmentsBySpecialization.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Specialization</th>
                                        <th class="text-center">Appointments</th>
                                        <th>Distribution</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var totalAppointments = appointmentsBySpecialization.Sum(x => (int)x.Count);
                                        var colors = new[] { "bg-primary", "bg-success", "bg-info", "bg-warning", "bg-danger", "bg-secondary" };
                                        var colorIndex = 0;
                                    }
                                    @foreach (var item in appointmentsBySpecialization)
                                    {
                                        var percentage = totalAppointments > 0 ? ((int)item.Count * 100.0 / totalAppointments) : 0;
                                        <tr>
                                            <td>
                                                <span class="badge @colors[colorIndex % colors.Length] me-2">&nbsp;</span>
                                                @item.Name
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-secondary fs-6">@item.Count</span>
                                            </td>
                                            <td>
                                                <div class="progress" style="height: 20px;">
                                                    <div class="progress-bar @colors[colorIndex % colors.Length]" 
                                                         role="progressbar" 
                                                         style="width: @percentage.ToString("F1")%"
                                                         aria-valuenow="@percentage" 
                                                         aria-valuemin="0" 
                                                         aria-valuemax="100">
                                                        @percentage.ToString("F1")%
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        colorIndex++;
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th>Total</th>
                                        <th class="text-center">@totalAppointments</th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-pie-chart fs-1 mb-3 d-block"></i>
                            <p>No appointment data available yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Top Doctors -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-trophy me-2"></i>Top 5 Doctors by Appointments</h5>
                </div>
                <div class="card-body">
                    @if (topDoctors != null && topDoctors.Any())
                    {
                        <div class="list-group list-group-flush">
                            @{
                                var rank = 1;
                                var medals = new[] { "🥇", "🥈", "🥉", "4️⃣", "5️⃣" };
                            }
                            @foreach (var doctor in topDoctors)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                    <div class="d-flex align-items-center">
                                        <span class="fs-4 me-3">@medals[rank - 1]</span>
                                        <div>
                                            <strong>@doctor.Name</strong>
                                            @if (rank == 1)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">Top Performer</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="badge bg-primary fs-6">@doctor.Count appointments</span>
                                </div>
                                rank++;
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-trophy fs-1 mb-3 d-block"></i>
                            <p>No doctor data available yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Row -->
    <div class="row g-4 mt-2">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body py-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-calendar-check text-primary fs-4"></i>
                    </div>
                    <h4 class="text-primary mb-1">@(appointmentsBySpecialization?.Sum(x => (int)x.Count) ?? 0)</h4>
                    <small class="text-muted">Total Appointments</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body py-4">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-cash-stack text-success fs-4"></i>
                    </div>
                    @{
                        var avgRevenue = (appointmentsBySpecialization?.Sum(x => (int)x.Count) ?? 0) > 0
                            ? (decimal)(ViewBag.TotalRevenue ?? 0) / (appointmentsBySpecialization?.Sum(x => (int)x.Count) ?? 1)
                            : 0;
                    }
                    <h4 class="text-success mb-1">$@avgRevenue.ToString("N2")</h4>
                    <small class="text-muted">Avg. per Appointment</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body py-4">
                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-tags text-info fs-4"></i>
                    </div>
                    <h4 class="text-info mb-1">@(appointmentsBySpecialization?.Count() ?? 0)</h4>
                    <small class="text-muted">Active Specializations</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body py-4">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-person-badge text-warning fs-4"></i>
                    </div>
                    <h4 class="text-warning mb-1">@(topDoctors?.Count() ?? 0)</h4>
                    <small class="text-muted">Active Doctors</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Card -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-auto">
                    <i class="bi bi-info-circle text-info fs-4"></i>
                </div>
                <div class="col">
                    <p class="mb-0 text-muted">
                        <strong>Note:</strong> Revenue is calculated from completed appointments only. 
                        Data refreshes in real-time based on appointment status changes.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

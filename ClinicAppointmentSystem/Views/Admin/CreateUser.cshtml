@model ClinicAppointmentSystem.ViewModels.AdminCreateUserViewModel

@{
    ViewData["Title"] = "Create New User";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-person-plus me-2"></i>Create New User</h2>
            <p class="text-muted mb-0">Add a new user to the system</p>
        </div>
        <a asp-action="Users" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Users
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateUser" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Account Information -->
                        <h5 class="border-bottom pb-2 mb-4 text-primary">
                            <i class="bi bi-person me-2"></i>Account Information
                        </h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="user@example.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" placeholder="Minimum 6 characters" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <small class="text-muted">Password must be at least 6 characters long</small>
                            </div>
                        </div>

                        <!-- Role & Status -->
                        <h5 class="border-bottom pb-2 mb-4 mt-4 text-warning">
                            <i class="bi bi-shield-lock me-2"></i>Role & Status
                        </h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Role" class="form-label"></label>
                                <select asp-for="Role" class="form-select">
                                    <option value="Patient">Patient</option>
                                    <option value="Doctor">Doctor</option>
                                    <option value="Admin">Admin</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Account Status</label>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                    <label asp-for="IsActive" class="form-check-label">Active Account</label>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info mt-3">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Note:</strong>
                            <ul class="mb-0 mt-2">
                                <li>If role is <strong>Patient</strong>, a basic patient profile will be created automatically.</li>
                                <li>If role is <strong>Doctor</strong>, you'll need to complete the doctor profile separately via Doctor Management.</li>
                                <li>The user will be able to log in immediately after creation (if active).</li>
                            </ul>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle me-1"></i> Create User
                            </button>
                            <a asp-action="Users" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Help Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Role Descriptions</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="d-flex align-items-center">
                            <span class="badge bg-primary me-2">Patient</span>
                        </h6>
                        <p class="small text-muted mb-0">
                            Can book appointments, view their medical records, manage their profile, and upload documents.
                        </p>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <h6 class="d-flex align-items-center">
                            <span class="badge bg-success me-2">Doctor</span>
                        </h6>
                        <p class="small text-muted mb-0">
                            Can manage their schedule, view and manage appointments, create medical notes, and view patient histories.
                        </p>
                    </div>
                    <hr />
                    <div>
                        <h6 class="d-flex align-items-center">
                            <span class="badge bg-danger me-2">Admin</span>
                        </h6>
                        <p class="small text-muted mb-0">
                            Full system access including user management, appointment oversight, reports, and system configuration.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Tips Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="bi bi-lightbulb me-2"></i>Tips</h6>
                </div>
                <div class="card-body">
                    <ul class="small text-muted mb-0">
                        <li class="mb-2">Use a strong password with at least 6 characters</li>
                        <li class="mb-2">Email addresses must be unique in the system</li>
                        <li class="mb-2">For doctors, use the <a asp-action="CreateDoctor">Add Doctor</a> form for complete profile creation</li>
                        <li>Users can change their password after logging in</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

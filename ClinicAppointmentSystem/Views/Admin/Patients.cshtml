@model IEnumerable<ClinicAppointmentSystem.Models.Patient>

@{
    ViewData["Title"] = "Manage Patients";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-people me-2"></i>Manage Patients</h2>
            <p class="text-muted mb-0">View and manage all registered patients</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Patients Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Patient</th>
                                <th>Contact</th>
                                <th>Date of Birth</th>
                                <th>Gender</th>
                                <th>Blood Type</th>
                                <th>Status</th>
                                <th>Joined</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                                <i class="bi bi-person text-primary fs-5"></i>
                                            </div>
                                            <div>
                                                <strong>@patient.User.FirstName @patient.User.LastName</strong>
                                                <br />
                                                <small class="text-muted">@patient.User.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <small>@(patient.User.PhoneNumber ?? "N/A")</small>
                                    </td>
                                    <td>
                                        @patient.DateOfBirth.ToString("MMM dd, yyyy")
                                        <br />
                                        <small class="text-muted">@((DateTime.Now.Year - patient.DateOfBirth.Year) + " years old")</small>
                                    </td>
                                    <td>
                                        @if (patient.Gender == "Male")
                                        {
                                            <span class="badge bg-info">@patient.Gender</span>
                                        }
                                        else if (patient.Gender == "Female")
                                        {
                                            <span class="badge bg-pink" style="background-color: #e91e8c;">@patient.Gender</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@patient.Gender</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(patient.BloodType))
                                        {
                                            <span class="badge bg-danger">@patient.BloodType</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (patient.User.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>@patient.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="PatientDetails" asp-route-id="@patient.PatientId" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="EditPatient" asp-route-id="@patient.PatientId" class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="TogglePatientStatus" asp-route-id="@patient.PatientId" method="post" class="d-inline">
                                                @if (patient.User.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate" onclick="return confirm('Are you sure you want to deactivate this patient?');">
                                                        <i class="bi bi-person-slash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activate" onclick="return confirm('Are you sure you want to activate this patient?');">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>
                                                }
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people fs-1 text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">No Patients Found</h5>
                    <p class="text-muted">Patients will appear here once they register.</p>
                </div>
            }
        </div>
    </div>

    
    
</div>
@model ClinicAppointmentSystem.ViewModels.AdminCreateDoctorViewModel

@{
    ViewData["Title"] = "Add New Doctor";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-person-plus me-2"></i>Add New Doctor</h2>
            <p class="text-muted mb-0">Create a new doctor account</p>
        </div>
        <a asp-action="Doctors" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Doctors
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateDoctor" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Account Information -->
                        <h5 class="border-bottom pb-2 mb-4 text-primary">
                            <i class="bi bi-person me-2"></i>Account Information
                        </h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" placeholder="doctor@example.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Enter phone number" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" placeholder="Minimum 6 characters" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Status</label>
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" checked />
                                    <label asp-for="IsActive" class="form-check-label">Active Account</label>
                                </div>
                            </div>
                        </div>

                        <!-- Professional Information -->
                        <h5 class="border-bottom pb-2 mb-4 mt-4 text-success">
                            <i class="bi bi-briefcase me-2"></i>Professional Information
                        </h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SpecializationId" class="form-label"></label>
                                <select asp-for="SpecializationId" class="form-select">
                                    <option value="">-- Select Specialization --</option>
                                    @if (ViewBag.Specializations != null)
                                    {
                                        @foreach (var spec in ViewBag.Specializations)
                                        {
                                            <option value="@spec.SpecializationId">@spec.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="SpecializationId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LicenseNumber" class="form-label"></label>
                                <input asp-for="LicenseNumber" class="form-control" placeholder="e.g., MD123456" />
                                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Biography" class="form-label"></label>
                            <textarea asp-for="Biography" class="form-control" rows="3" placeholder="Brief description of experience and expertise..."></textarea>
                            <span asp-validation-for="Biography" class="text-danger"></span>
                        </div>

                        <!-- Consultation Details -->
                        <h5 class="border-bottom pb-2 mb-4 mt-4 text-info">
                            <i class="bi bi-clock me-2"></i>Consultation Details
                        </h5>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConsultationDuration" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="ConsultationDuration" class="form-control" type="number" min="15" max="120" />
                                    <span class="input-group-text">minutes</span>
                                </div>
                                <span asp-validation-for="ConsultationDuration" class="text-danger"></span>
                                <small class="text-muted">Duration per appointment (15-120 minutes)</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConsultationFee" class="form-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="ConsultationFee" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="ConsultationFee" class="text-danger"></span>
                                <small class="text-muted">Fee per consultation</small>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex gap-2 mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle me-1"></i> Create Doctor
                            </button>
                            <a asp-action="Doctors" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-x-circle me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar Help -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Help</h6>
                </div>
                <div class="card-body">
                    <h6>Creating a Doctor Account</h6>
                    <ul class="small text-muted mb-0">
                        <li>All fields marked are required</li>
                        <li>Email must be unique in the system</li>
                        <li>License number must be unique</li>
                        <li>Password must be at least 6 characters</li>
                        <li>Doctor can update their profile later</li>
                    </ul>
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Note</h6>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-0">
                        After creating the doctor account, the doctor will need to set up their working hours
                        before patients can book appointments with them.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
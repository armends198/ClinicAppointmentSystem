@model ClinicAppointmentSystem.Models.User

@{
    ViewData["Title"] = "User Details";
    var patient = ViewBag.Patient as ClinicAppointmentSystem.Models.Patient;
    var doctor = ViewBag.Doctor as ClinicAppointmentSystem.Models.Doctor;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-person-circle me-2"></i>User Details</h2>
            <p class="text-muted mb-0">View detailed information about this user</p>
        </div>
        <div>
            <a asp-action="EditUser" asp-route-id="@Model.UserId" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i> Edit User
            </a>
            <a asp-action="Users" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Users
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- User Info Card -->
            <div class="card border-0 shadow-sm mb-4">
                @{
                    var headerColor = Model.Role switch
                    {
                        "Admin" => "bg-danger",
                        "Doctor" => "bg-success",
                        "Patient" => "bg-primary",
                        _ => "bg-secondary"
                    };
                }
                <div class="card-header @headerColor text-white">
                    <h5 class="mb-0"><i class="bi bi-person me-2"></i>Account Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Full Name</label>
                            <p class="fw-bold mb-0 fs-5">@Model.FirstName @Model.LastName</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Email Address</label>
                            <p class="mb-0">
                                <a href="mailto:@Model.Email" class="text-decoration-none">
                                    <i class="bi bi-envelope me-1"></i>@Model.Email
                                </a>
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Phone Number</label>
                            <p class="mb-0">
                                @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                                {
                                    <i class="bi bi-telephone me-1"></i>@Model.PhoneNumber
                                }
                                else
                                {
                                    <span class="text-muted">Not provided</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Role</label>
                            <p class="mb-0">
                                @{
                                    var roleBadgeClass = Model.Role switch
                                    {
                                        "Admin" => "bg-danger",
                                        "Doctor" => "bg-success",
                                        "Patient" => "bg-primary",
                                        _ => "bg-secondary"
                                    };
                                    var roleIcon = Model.Role switch
                                    {
                                        "Admin" => "bi-shield-lock",
                                        "Doctor" => "bi-person-badge",
                                        "Patient" => "bi-person",
                                        _ => "bi-person"
                                    };
                                }
                                <span class="badge @roleBadgeClass fs-6">
                                    <i class="bi @roleIcon me-1"></i>@Model.Role
                                </span>
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Account Status</label>
                            <p class="mb-0">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Inactive</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Member Since</label>
                            <p class="mb-0">@Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Role-Specific Information -->
            @if (Model.Role == "Patient" && patient != null)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-heart-pulse me-2"></i>Patient Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">Date of Birth</label>
                                <p class="mb-0">@patient.DateOfBirth.ToString("MMMM dd, yyyy")</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">Gender</label>
                                <p class="mb-0">@patient.Gender</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">Blood Type</label>
                                <p class="mb-0">
                                    @if (!string.IsNullOrEmpty(patient.BloodType))
                                    {
                                        <span class="badge bg-danger">@patient.BloodType</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">Allergies</label>
                                <p class="mb-0">
                                    @if (!string.IsNullOrEmpty(patient.Allergies))
                                    {
                                        <span class="text-danger">@patient.Allergies</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">None reported</span>
                                    }
                                </p>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label text-muted small">Address</label>
                                <p class="mb-0">@(patient.Address ?? "Not provided")</p>
                            </div>
                        </div>
                        <hr />
                        <a asp-action="PatientDetails" asp-route-id="@patient.PatientId" class="btn btn-outline-info">
                            <i class="bi bi-eye me-1"></i> View Full Patient Profile
                        </a>
                    </div>
                </div>
            }

            @if (Model.Role == "Doctor" && doctor != null)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-briefcase me-2"></i>Doctor Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">Specialization</label>
                                <p class="mb-0">
                                    <span class="badge bg-primary fs-6">@doctor.Specialization?.Name</span>
                                </p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">License Number</label>
                                <p class="fw-bold mb-0">@doctor.LicenseNumber</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">Consultation Fee</label>
                                <p class="fw-bold mb-0 text-success">$@doctor.ConsultationFee.ToString("0.00")</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label text-muted small">Consultation Duration</label>
                                <p class="mb-0">@doctor.ConsultationDuration minutes</p>
                            </div>
                            @if (!string.IsNullOrEmpty(doctor.Biography))
                            {
                                <div class="col-12 mb-3">
                                    <label class="form-label text-muted small">Biography</label>
                                    <p class="mb-0">@doctor.Biography</p>
                                </div>
                            }
                        </div>
                        <hr />
                        <a asp-action="DoctorDetails" asp-route-id="@doctor.DoctorId" class="btn btn-outline-success">
                            <i class="bi bi-eye me-1"></i> View Full Doctor Profile
                        </a>
                    </div>
                </div>
            }

            @if (Model.Role == "Admin")
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-danger text-white">
                        <h5 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Administrator</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-info-circle text-info fs-4 me-3"></i>
                            <p class="mb-0">
                                This user has full administrative privileges including user management, 
                                appointment management, and system configuration.
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- User Avatar Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body text-center py-4">
                    @{
                        var avatarBg = Model.Role switch
                        {
                            "Admin" => "bg-danger",
                            "Doctor" => "bg-success",
                            "Patient" => "bg-primary",
                            _ => "bg-secondary"
                        };
                    }
                    <div class="@avatarBg bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 100px; height: 100px;">
                        <i class="bi @roleIcon @avatarBg.Replace("bg-", "text-")" style="font-size: 3rem;"></i>
                    </div>
                    <h4>@Model.FirstName @Model.LastName</h4>
                    <p class="text-muted mb-2">@Model.Email</p>
                    <span class="badge @roleBadgeClass fs-6">@Model.Role</span>
                </div>
            </div>

            <!-- Stats Card -->
            @if (Model.Role != "Admin")
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Statistics</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted">Total Appointments</span>
                            <span class="badge bg-primary fs-6">@(ViewBag.AppointmentCount ?? 0)</span>
                        </div>
                    </div>
                </div>
            }

            <!-- Timeline Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Timeline</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex mb-3">
                        <div class="me-3">
                            <span class="badge bg-success rounded-circle p-2"><i class="bi bi-plus-circle"></i></span>
                        </div>
                        <div>
                            <strong>Account Created</strong>
                            <br />
                            <small class="text-muted">@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</small>
                        </div>
                    </div>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="d-flex">
                            <div class="me-3">
                                <span class="badge bg-warning rounded-circle p-2"><i class="bi bi-pencil"></i></span>
                            </div>
                            <div>
                                <strong>Last Updated</strong>
                                <br />
                                <small class="text-muted">@Model.UpdatedAt.Value.ToString("MMM dd, yyyy hh:mm tt")</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-gear me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body d-grid gap-2">
                    <a asp-action="EditUser" asp-route-id="@Model.UserId" class="btn btn-outline-warning">
                        <i class="bi bi-pencil me-1"></i> Edit User
                    </a>
                    <form asp-action="ToggleUserStatus" asp-route-id="@Model.UserId" method="post">
                        @if (Model.IsActive)
                        {
                            <button type="submit" class="btn btn-outline-secondary w-100" onclick="return confirm('Deactivate this user?');">
                                <i class="bi bi-person-slash me-1"></i> Deactivate User
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-outline-success w-100" onclick="return confirm('Activate this user?');">
                                <i class="bi bi-person-check me-1"></i> Activate User
                            </button>
                        }
                    </form>
                    <form asp-action="DeleteUser" asp-route-id="@Model.UserId" method="post">
                        <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                            <i class="bi bi-trash me-1"></i> Delete User
                        </button>
                    </form>
                    <hr />
                    <a asp-action="Users" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Users
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

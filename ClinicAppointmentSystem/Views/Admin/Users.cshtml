@model IEnumerable<ClinicAppointmentSystem.Models.User>

@{
    ViewData["Title"] = "Manage Users";
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-people me-2"></i>Manage Users</h2>
            <p class="text-muted mb-0">View and manage all system users</p>
        </div>
        <div>
            <a asp-action="CreateUser" class="btn btn-success">
                <i class="bi bi-person-plus me-1"></i> Add New User
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filter Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col">
            <a asp-action="Users" asp-route-role="all" class="text-decoration-none">
                <div class="card border-0 shadow-sm @(currentFilter == "all" ? "border-primary border-2" : "")">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-1 text-primary">@ViewBag.TotalUsers</h4>
                        <small class="text-muted">All Users</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-action="Users" asp-route-role="patient" class="text-decoration-none">
                <div class="card border-0 shadow-sm @(currentFilter == "patient" ? "border-info border-2" : "")">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-1 text-info">@ViewBag.PatientCount</h4>
                        <small class="text-muted">Patients</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-action="Users" asp-route-role="doctor" class="text-decoration-none">
                <div class="card border-0 shadow-sm @(currentFilter == "doctor" ? "border-success border-2" : "")">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-1 text-success">@ViewBag.DoctorCount</h4>
                        <small class="text-muted">Doctors</small>
                    </div>
                </div>
            </a>
        </div>
        <div class="col">
            <a asp-action="Users" asp-route-role="admin" class="text-decoration-none">
                <div class="card border-0 shadow-sm @(currentFilter == "admin" ? "border-danger border-2" : "")">
                    <div class="card-body text-center py-3">
                        <h4 class="mb-1 text-danger">@ViewBag.AdminCount</h4>
                        <small class="text-muted">Admins</small>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    @if (currentFilter == "all")
                    {
                        <span>All Users</span>
                    }
                    else
                    {
                        <span>@(currentFilter.Substring(0, 1).ToUpper() + currentFilter.Substring(1))s</span>
                    }
                </h5>
                <span class="badge bg-secondary">@Model.Count() records</span>
            </div>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>User</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Joined</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark">#@user.UserId</span></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @{
                                                var avatarColor = user.Role switch
                                                {
                                                    "Admin" => "bg-danger",
                                                    "Doctor" => "bg-success",
                                                    "Patient" => "bg-primary",
                                                    _ => "bg-secondary"
                                                };
                                                var avatarIcon = user.Role switch
                                                {
                                                    "Admin" => "bi-shield-lock",
                                                    "Doctor" => "bi-person-badge",
                                                    "Patient" => "bi-person",
                                                    _ => "bi-person"
                                                };
                                            }
                                            <div class="@avatarColor bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                                <i class="bi @avatarIcon @avatarColor.Replace("bg-", "text-")"></i>
                                            </div>
                                            <div>
                                                <strong>@user.FirstName @user.LastName</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@(user.PhoneNumber ?? "N/A")</td>
                                    <td>
                                        @{
                                            var roleBadgeClass = user.Role switch
                                            {
                                                "Admin" => "bg-danger",
                                                "Doctor" => "bg-success",
                                                "Patient" => "bg-primary",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @roleBadgeClass">@user.Role</span>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="UserDetails" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="EditUser" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="ToggleUserStatus" asp-route-id="@user.UserId" method="post" class="d-inline">
                                                @if (user.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Deactivate" onclick="return confirm('Deactivate this user?');">
                                                        <i class="bi bi-person-slash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Activate" onclick="return confirm('Activate this user?');">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>
                                                }
                                            </form>
                                            <form asp-action="DeleteUser" asp-route-id="@user.UserId" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people fs-1 text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">No Users Found</h5>
                    <p class="text-muted">
                        @if (currentFilter != "all")
                        {
                            <span>No @currentFilter users found.</span>
                            <br />
                            <a asp-action="Users" asp-route-role="all" class="btn btn-outline-primary mt-2">View All Users</a>
                        }
                        else
                        {
                            <span>No users registered yet.</span>
                        }
                    </p>
                </div>
            }
        </div>
    </div>

    <!-- Info Card -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-info-circle text-info fs-4 me-3"></i>
                        <div>
                            <strong>Tip:</strong>
                            <p class="mb-0 small text-muted">Use role filters above to quickly find specific user types.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-check text-success fs-4 me-3"></i>
                        <div>
                            <strong>Security:</strong>
                            <p class="mb-0 small text-muted">You cannot delete or deactivate your own admin account.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle text-warning fs-4 me-3"></i>
                        <div>
                            <strong>Note:</strong>
                            <p class="mb-0 small text-muted">Users with appointments cannot be deleted, only deactivated.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

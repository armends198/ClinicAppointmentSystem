@model IEnumerable<ClinicAppointmentSystem.Models.Specialization>

@{
    ViewData["Title"] = "Manage Specializations";
    var doctorCounts = ViewBag.DoctorCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-tags me-2"></i>Manage Specializations</h2>
            <p class="text-muted mb-0">View and manage medical specializations</p>
        </div>
        <div>
            <a asp-action="CreateSpecialization" class="btn btn-success">
                <i class="bi bi-plus-circle me-1"></i> Add New Specialization
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Specializations Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var spec in Model)
            {
                var count = doctorCounts.ContainsKey(spec.SpecializationId) ? doctorCounts[spec.SpecializationId] : 0;
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                    <i class="bi bi-heart-pulse text-primary fs-4"></i>
                                </div>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a asp-action="EditSpecialization" asp-route-id="@spec.SpecializationId" class="dropdown-item">
                                                <i class="bi bi-pencil me-2"></i> Edit
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <form asp-action="DeleteSpecialization" asp-route-id="@spec.SpecializationId" method="post" onsubmit="return confirm('Are you sure you want to delete this specialization? This action cannot be undone.');">
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-trash me-2"></i> Delete
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <h5 class="card-title mb-2">@spec.Name</h5>
                            <p class="card-text text-muted small mb-3">
                                @(spec.Description ?? "No description available")
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-success">
                                    <i class="bi bi-person-badge me-1"></i> @count Doctor@(count != 1 ? "s" : "")
                                </span>
                                <a asp-action="EditSpecialization" asp-route-id="@spec.SpecializationId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Summary -->
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="text-primary">@Model.Count()</h3>
                        <small class="text-muted">Total Specializations</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="text-success">@doctorCounts.Values.Sum()</h3>
                        <small class="text-muted">Total Doctors</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <h3 class="text-info">@Model.Count(s => !doctorCounts.ContainsKey(s.SpecializationId) || doctorCounts[s.SpecializationId] == 0)</h3>
                        <small class="text-muted">Without Doctors</small>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-tags fs-1 text-muted mb-3 d-block"></i>
                <h5 class="text-muted">No Specializations Found</h5>
                <p class="text-muted">Get started by adding your first specialization.</p>
                <a asp-action="CreateSpecialization" class="btn btn-success">
                    <i class="bi bi-plus-circle me-1"></i> Add New Specialization
                </a>
            </div>
        </div>
    }

    <!-- Info Card -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body">
            <h6 class="mb-3"><i class="bi bi-info-circle me-2"></i>About Specializations</h6>
            <div class="row">
                <div class="col-md-6">
                    <p class="small text-muted mb-0">
                        <i class="bi bi-check-circle text-success me-2"></i>
                        Specializations are used to categorize doctors by their medical expertise.
                    </p>
                </div>
                <div class="col-md-6">
                    <p class="small text-muted mb-0">
                        <i class="bi bi-exclamation-triangle text-warning me-2"></i>
                        You cannot delete a specialization if doctors are assigned to it.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
@model ClinicAppointmentSystem.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-calendar-check me-2"></i>Appointment Details</h2>
            <p class="text-muted mb-0">Appointment #@Model.AppointmentId</p>
        </div>
        <a asp-action="Appointments" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Appointments
        </a>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Appointment Status Banner -->
            <div class="card border-0 shadow-sm mb-4">
                @{
                    var bannerClass = Model.StatusId switch
                    {
                        1 => "bg-warning",
                        2 => "bg-info",
                        3 => "bg-success",
                        4 => "bg-danger",
                        _ => "bg-secondary"
                    };
                    var bannerTextClass = Model.StatusId == 1 ? "text-dark" : "text-white";
                }
                <div class="card-body @bannerClass @bannerTextClass">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1">
                                @if (Model.StatusId == 1)
                                {
                                    <i class="bi bi-clock me-2"></i>
                                }
                                else if (Model.StatusId == 2)
                                {
                                    <i class="bi bi-check-circle me-2"></i>
                                }
                                else if (Model.StatusId == 3)
                                {
                                    <i class="bi bi-check-all me-2"></i>
                                }
                                else if (Model.StatusId == 4)
                                {
                                    <i class="bi bi-x-circle me-2"></i>
                                }
                                @Model.AppointmentStatus.StatusName
                            </h4>
                            <p class="mb-0">@Model.AppointmentStatus.Description</p>
                        </div>
                        <div>
                            <span class="fs-1 opacity-50">
                                @if (Model.StatusId == 1)
                                {
                                    <i class="bi bi-hourglass-split"></i>
                                }
                                else if (Model.StatusId == 2)
                                {
                                    <i class="bi bi-calendar-check"></i>
                                }
                                else if (Model.StatusId == 3)
                                {
                                    <i class="bi bi-clipboard-check"></i>
                                }
                                else if (Model.StatusId == 4)
                                {
                                    <i class="bi bi-calendar-x"></i>
                                }
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Appointment Info -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Appointment Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Date</label>
                            <p class="fw-bold mb-0 fs-5">@Model.TimeSlot.StartDateTime.ToString("dddd, MMMM dd, yyyy")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Time</label>
                            <p class="fw-bold mb-0 fs-5">
                                @Model.TimeSlot.StartDateTime.ToString("hh:mm tt") - @Model.TimeSlot.EndDateTime.ToString("hh:mm tt")
                            </p>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label text-muted small">Reason for Visit</label>
                            <p class="mb-0">@(Model.Reason ?? "Not specified")</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="col-12">
                                <label class="form-label text-muted small">Additional Notes</label>
                                <p class="mb-0">@Model.Notes</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Patient Info -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-person me-2"></i>Patient Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Full Name</label>
                            <p class="fw-bold mb-0">@Model.Patient.User.FirstName @Model.Patient.User.LastName</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Email</label>
                            <p class="mb-0">@Model.Patient.User.Email</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Phone</label>
                            <p class="mb-0">@(Model.Patient.User.PhoneNumber ?? "Not provided")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Date of Birth</label>
                            <p class="mb-0">@Model.Patient.DateOfBirth.ToString("MMMM dd, yyyy")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Blood Type</label>
                            <p class="mb-0">
                                @if (!string.IsNullOrEmpty(Model.Patient.BloodType))
                                {
                                    <span class="badge bg-danger">@Model.Patient.BloodType</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not provided</span>
                                }
                            </p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Allergies</label>
                            <p class="mb-0">
                                @if (!string.IsNullOrEmpty(Model.Patient.Allergies))
                                {
                                    <span class="text-danger">@Model.Patient.Allergies</span>
                                }
                                else
                                {
                                    <span class="text-muted">None reported</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="mt-2">
                        <a asp-action="PatientDetails" asp-route-id="@Model.PatientId" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-eye me-1"></i> View Full Patient Profile
                        </a>
                    </div>
                </div>
            </div>

            <!-- Doctor Info -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Doctor Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Full Name</label>
                            <p class="fw-bold mb-0">Dr. @Model.Doctor.User.FirstName @Model.Doctor.User.LastName</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Specialization</label>
                            <p class="mb-0"><span class="badge bg-primary fs-6">@Model.Doctor.Specialization.Name</span></p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Email</label>
                            <p class="mb-0">@Model.Doctor.User.Email</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Phone</label>
                            <p class="mb-0">@(Model.Doctor.User.PhoneNumber ?? "Not provided")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Consultation Fee</label>
                            <p class="fw-bold mb-0 text-success">$@Model.Doctor.ConsultationFee.ToString("0.00")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Consultation Duration</label>
                            <p class="mb-0">@Model.Doctor.ConsultationDuration minutes</p>
                        </div>
                    </div>
                    <div class="mt-2">
                        <a asp-action="DoctorDetails" asp-route-id="@Model.DoctorId" class="btn btn-sm btn-outline-info">
                            <i class="bi bi-eye me-1"></i> View Full Doctor Profile
                        </a>
                    </div>
                </div>
            </div>

            <!-- Doctor Notes -->
            @if (Model.DoctorNotes != null && Model.DoctorNotes.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><i class="bi bi-journal-medical me-2"></i>Doctor Notes</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var note in Model.DoctorNotes)
                        {
                            <div class="mb-4">
                                <h6 class="text-primary"><i class="bi bi-clipboard-pulse me-2"></i>Diagnosis</h6>
                                <p class="ms-4">@note.Diagnosis</p>
                            </div>

                            @if (!string.IsNullOrEmpty(note.Treatment))
                            {
                                <div class="mb-4">
                                    <h6 class="text-primary"><i class="bi bi-heart-pulse me-2"></i>Treatment</h6>
                                    <p class="ms-4">@note.Treatment</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(note.Prescription))
                            {
                                <div class="mb-4">
                                    <h6 class="text-primary"><i class="bi bi-capsule me-2"></i>Prescription</h6>
                                    <p class="ms-4">@note.Prescription</p>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(note.AdditionalNotes))
                            {
                                <div class="mb-0">
                                    <h6 class="text-primary"><i class="bi bi-journal-text me-2"></i>Additional Notes</h6>
                                    <p class="ms-4 mb-0">@note.AdditionalNotes</p>
                                </div>
                            }

                            <hr />
                            <small class="text-muted">Note created: @note.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")</small>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Status Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Appointment Summary</h6>
                </div>
                <div class="card-body text-center">
                    @{
                        var statusBadgeClass = Model.StatusId switch
                        {
                            1 => "bg-warning",
                            2 => "bg-info",
                            3 => "bg-success",
                            4 => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadgeClass fs-5 mb-3">@Model.AppointmentStatus.StatusName</span>
                    <hr />
                    <p class="mb-1"><strong>Appointment ID:</strong> #@Model.AppointmentId</p>
                    <p class="mb-1"><strong>Date:</strong> @Model.TimeSlot.StartDateTime.ToString("MMM dd, yyyy")</p>
                    <p class="mb-1"><strong>Time:</strong> @Model.TimeSlot.StartDateTime.ToString("hh:mm tt")</p>
                    <p class="mb-0"><strong>Fee:</strong> <span class="text-success">$@Model.Doctor.ConsultationFee.ToString("0.00")</span></p>
                </div>
            </div>

            <!-- Timeline -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-clock-history me-2"></i>Timeline</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex mb-3">
                        <div class="me-3">
                            <span class="badge bg-primary rounded-circle p-2"><i class="bi bi-plus-circle"></i></span>
                        </div>
                        <div>
                            <strong>Created</strong>
                            <br />
                            <small class="text-muted">@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</small>
                        </div>
                    </div>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="d-flex">
                            <div class="me-3">
                                <span class="badge bg-secondary rounded-circle p-2"><i class="bi bi-pencil"></i></span>
                            </div>
                            <div>
                                <strong>Last Updated</strong>
                                <br />
                                <small class="text-muted">@Model.UpdatedAt.Value.ToString("MMM dd, yyyy hh:mm tt")</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-gear me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body d-grid gap-2">
                    @if (Model.StatusId == 1) // Pending
                    {
                        <form asp-action="UpdateAppointmentStatus" method="post">
                            <input type="hidden" name="id" value="@Model.AppointmentId" />
                            <input type="hidden" name="statusId" value="2" />
                            <button type="submit" class="btn btn-success w-100" onclick="return confirm('Approve this appointment?');">
                                <i class="bi bi-check-circle me-1"></i> Approve Appointment
                            </button>
                        </form>
                        <form asp-action="UpdateAppointmentStatus" method="post">
                            <input type="hidden" name="id" value="@Model.AppointmentId" />
                            <input type="hidden" name="statusId" value="4" />
                            <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Cancel this appointment?');">
                                <i class="bi bi-x-circle me-1"></i> Cancel Appointment
                            </button>
                        </form>
                    }
                    @if (Model.StatusId == 2) // Approved
                    {
                        <form asp-action="UpdateAppointmentStatus" method="post">
                            <input type="hidden" name="id" value="@Model.AppointmentId" />
                            <input type="hidden" name="statusId" value="3" />
                            <button type="submit" class="btn btn-primary w-100" onclick="return confirm('Mark this appointment as completed?');">
                                <i class="bi bi-check-all me-1"></i> Mark as Completed
                            </button>
                        </form>
                        <form asp-action="UpdateAppointmentStatus" method="post">
                            <input type="hidden" name="id" value="@Model.AppointmentId" />
                            <input type="hidden" name="statusId" value="4" />
                            <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Cancel this appointment?');">
                                <i class="bi bi-x-circle me-1"></i> Cancel Appointment
                            </button>
                        </form>
                    }
                    <a asp-action="PatientDetails" asp-route-id="@Model.PatientId" class="btn btn-outline-success">
                        <i class="bi bi-person me-1"></i> View Patient
                    </a>
                    <a asp-action="DoctorDetails" asp-route-id="@Model.DoctorId" class="btn btn-outline-info">
                        <i class="bi bi-person-badge me-1"></i> View Doctor
                    </a>
                    <a asp-action="Appointments" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
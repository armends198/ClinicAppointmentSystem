@model ClinicAppointmentSystem.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-person-badge me-2"></i>Doctor Details</h2>
            <p class="text-muted mb-0">View detailed information about this doctor</p>
        </div>
        <div>
            <a asp-action="EditDoctor" asp-route-id="@Model.DoctorId" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i> Edit Doctor
            </a>
            <a asp-action="Doctors" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Doctors
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Doctor Info -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-person me-2"></i>Personal Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Full Name</label>
                            <p class="fw-bold mb-0">Dr. @Model.User.FirstName @Model.User.LastName</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Email</label>
                            <p class="mb-0">@Model.User.Email</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Phone Number</label>
                            <p class="mb-0">@(Model.User.PhoneNumber ?? "Not provided")</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Status</label>
                            <p class="mb-0">
                                @if (Model.User.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-briefcase me-2"></i>Professional Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Specialization</label>
                            <p class="mb-0"><span class="badge bg-primary fs-6">@Model.Specialization.Name</span></p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">License Number</label>
                            <p class="fw-bold mb-0">@Model.LicenseNumber</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Consultation Duration</label>
                            <p class="mb-0">@Model.ConsultationDuration minutes</p>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">Consultation Fee</label>
                            <p class="fw-bold mb-0 text-success">$@Model.ConsultationFee.ToString("0.00")</p>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label text-muted small">Biography</label>
                            <p class="mb-0">@(Model.Biography ?? "No biography provided")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Working Hours -->
            @if (Model.WorkingHours != null && Model.WorkingHours.Any())
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-clock me-2"></i>Working Hours</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Day</th>
                                        <th>Start Time</th>
                                        <th>End Time</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var days = new[] { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };
                                    }
                                    @foreach (var wh in Model.WorkingHours.OrderBy(w => w.DayOfWeek == 0 ? 7 : w.DayOfWeek))
                                    {
                                        <tr>
                                            <td>@days[wh.DayOfWeek]</td>
                                            <td>@wh.StartTime.ToString(@"hh\:mm")</td>
                                            <td>@wh.EndTime.ToString(@"hh\:mm")</td>
                                            <td>
                                                @if (wh.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar Stats -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Appointment Statistics</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Total Appointments</span>
                        <span class="badge bg-primary fs-6">@ViewBag.TotalAppointments</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Completed</span>
                        <span class="badge bg-success fs-6">@ViewBag.CompletedAppointments</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Pending</span>
                        <span class="badge bg-warning fs-6">@ViewBag.PendingAppointments</span>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-calendar me-2"></i>Account Info</h6>
                </div>
                <div class="card-body">
                    <p class="mb-2"><strong>Joined:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <p class="mb-0"><strong>Last Updated:</strong> @Model.UpdatedAt.Value.ToString("MMMM dd, yyyy")</p>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-gear me-2"></i>Quick Actions</h6>
                </div>
                <div class="card-body d-grid gap-2">
                    <a asp-action="EditDoctor" asp-route-id="@Model.DoctorId" class="btn btn-outline-warning">
                        <i class="bi bi-pencil me-1"></i> Edit Doctor
                    </a>
                    <form asp-action="ToggleDoctorStatus" asp-route-id="@Model.DoctorId" method="post">
                        @if (Model.User.IsActive)
                        {
                            <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Are you sure you want to deactivate this doctor?');">
                                <i class="bi bi-person-slash me-1"></i> Deactivate Doctor
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-outline-success w-100" onclick="return confirm('Are you sure you want to activate this doctor?');">
                                <i class="bi bi-person-check me-1"></i> Activate Doctor
                            </button>
                        }
                    </form>
                    <a asp-action="Doctors" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
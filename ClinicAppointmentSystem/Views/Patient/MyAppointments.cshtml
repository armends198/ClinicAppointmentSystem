@model List<ClinicAppointmentSystem.Models.Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-calendar-check"></i> My Appointments</h2>
                <div>
                    <a asp-action="BookAppointment" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Book New Appointment
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date & Time</th>
                                <th>Doctor</th>
                                <th>Specialization</th>
                                <th>Reason</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@appointment.TimeSlot.StartDateTime.ToString("MMM dd, yyyy")</strong><br>
                                        <small class="text-muted">@appointment.TimeSlot.StartDateTime.ToString("hh:mm tt") - @appointment.TimeSlot.EndDateTime.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>Dr. @appointment.Doctor.User.FirstName @appointment.Doctor.User.LastName</td>
                                    <td>@appointment.Doctor.Specialization.Name</td>
                                    <td>@(appointment.Reason ?? "Not specified")</td>
                                    <td>
                                        @if (appointment.AppointmentStatus.StatusName == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock"></i> @appointment.AppointmentStatus.StatusName
                                            </span>
                                        }
                                        else if (appointment.AppointmentStatus.StatusName == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> @appointment.AppointmentStatus.StatusName
                                            </span>
                                        }
                                        else if (appointment.AppointmentStatus.StatusName == "Completed")
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-check-all"></i> @appointment.AppointmentStatus.StatusName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> @appointment.AppointmentStatus.StatusName
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (appointment.AppointmentStatus.StatusName == "Pending" || appointment.AppointmentStatus.StatusName == "Approved")
                                        {
                                            <form asp-action="CancelAppointment" method="post" style="display:inline;"
                                                  onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                                <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-x-circle"></i> Cancel
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-x fs-1 text-muted"></i>
                <h4 class="mt-3">No Appointments Yet</h4>
                <p class="text-muted">You haven't booked any appointments. Start by booking your first appointment!</p>
                <a asp-action="BookAppointment" class="btn btn-primary mt-3">
                    <i class="bi bi-calendar-plus"></i> Book Your First Appointment
                </a>
            </div>
        </div>
    }
</div>
@model ClinicAppointmentSystem.Models.MedicalHistory

@{
    ViewData["Title"] = "Add Medical History";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Add Medical History</h2>
            <p class="text-muted">Add a chronic condition or past diagnosis to your medical records</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="AddMedicalHistory" method="post">
                <div class="mb-3">
                    <label asp-for="ConditionName" class="form-label">Condition Name <span class="text-danger">*</span></label>
                    <input asp-for="ConditionName" class="form-control" placeholder="e.g., Diabetes Type 2, Hypertension" required />
                    <span asp-validation-for="ConditionName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiagnosedDate" class="form-label">Diagnosed Date <span class="text-danger">*</span></label>
                    <input asp-for="DiagnosedDate" type="date" class="form-control" required />
                    <span asp-validation-for="DiagnosedDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="IsOngoing" class="form-check-input" type="checkbox" />
                        <label asp-for="IsOngoing" class="form-check-label">
                            This condition is ongoing
                        </label>
                    </div>
                    <small class="text-muted">Check this if you are currently managing this condition</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Additional information about this condition, treatment history, etc."></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Save
                    </button>
                    <a asp-action="MedicalHistory" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
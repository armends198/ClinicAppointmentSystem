@model IEnumerable<ClinicAppointmentSystem.Models.MedicalHistory>

@{
    ViewData["Title"] = "My Medical History";
    var patient = ViewBag.Patient as ClinicAppointmentSystem.Models.Patient;
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2>My Medical History</h2>
                    <p class="text-muted">Manage your chronic conditions and past diagnoses</p>
                </div>
                <a asp-action="AddMedicalHistory" class="btn btn-success">
                    <i class="bi bi-plus-circle"></i> Add New Condition
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Condition</th>
                                <th>Diagnosed Date</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in Model)
                            {
                                <tr>
                                    <td><strong>@history.ConditionName</strong></td>
                                    <td>@history.DiagnosedDate.ToString("MMMM dd, yyyy")</td>
                                    <td>
                                        @if (history.IsOngoing)
                                        {
                                            <span class="badge bg-warning">Ongoing</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Resolved</span>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrEmpty(history.Notes) ? "-" : history.Notes)</td>
                                    <td>
                                        <a href="@Url.Action("EditMedicalHistory", new { id = history.HistoryId })" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <form asp-action="DeleteMedicalHistory" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this record?');">
                                            <input type="hidden" name="id" value="@history.HistoryId" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-clipboard2-pulse fs-1 text-muted"></i>
                    <p class="text-muted mt-3">No medical history recorded.</p>
                    <a asp-action="AddMedicalHistory" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Add Your First Condition
                    </a>
                </div>
            }
        </div>
    </div>
</div>
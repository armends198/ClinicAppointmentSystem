@model IEnumerable<ClinicAppointmentSystem.Models.PatientDocument>

@{
    ViewData["Title"] = "My Documents";
    var patient = ViewBag.Patient as ClinicAppointmentSystem.Models.Patient;
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2>My Medical Documents</h2>
                    <p class="text-muted">Upload and manage your lab results, imaging, prescriptions, and other medical documents</p>
                </div>
                <a asp-action="UploadDocument" class="btn btn-success">
                    <i class="bi bi-cloud-upload"></i> Upload Document
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Document Name</th>
                                <th>Type</th>
                                <th>Upload Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var document in Model)
                            {
                                <tr>
                                    <td>
                                        <i class="bi bi-file-earmark-text"></i>
                                        <strong>@document.DocumentName</strong>
                                    </td>
                                    <td>
                                        @if (document.DocumentType == "LabResult")
                                        {
                                            <span class="badge bg-primary">Lab Result</span>
                                        }
                                        else if (document.DocumentType == "Imaging")
                                        {
                                            <span class="badge bg-info">Imaging</span>
                                        }
                                        else if (document.DocumentType == "Prescription")
                                        {
                                            <span class="badge bg-success">Prescription</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@document.DocumentType</span>
                                        }
                                    </td>
                                    <td>@document.UploadedAt.ToString("MMMM dd, yyyy")</td>
                                    <td>
                                        <a href="@document.FilePath" target="_blank" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                        <a href="@document.FilePath" download class="btn btn-sm btn-info">
                                            <i class="bi bi-download"></i> Download
                                        </a>
                                        <form asp-action="DeleteDocument" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this document?');">
                                            <input type="hidden" name="id" value="@document.DocumentId" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-medical fs-1 text-muted"></i>
                    <p class="text-muted mt-3">No documents uploaded yet.</p>
                    <a asp-action="UploadDocument" class="btn btn-primary mt-2">
                        <i class="bi bi-cloud-upload"></i> Upload Your First Document
                    </a>
                </div>
            }
        </div>
    </div>
</div>
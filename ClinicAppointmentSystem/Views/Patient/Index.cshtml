@{
    ViewData["Title"] = "Patient Dashboard";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <h2>Welcome, @ViewBag.PatientName!</h2>
            <p class="text-muted">Manage your appointments and health records</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-calendar-plus fs-1 text-primary"></i>
                    <h5 class="card-title mt-3">Book Appointment</h5>
                    <p class="card-text">Schedule a new appointment with a doctor</p>
                    <a asp-action="BookAppointment" class="btn btn-primary">Book Now</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-calendar-check fs-1 text-success"></i>
                    <h5 class="card-title mt-3">My Appointments</h5>
                    <p class="card-text">View and manage your appointments</p>
                    <a asp-action="MyAppointments" class="btn btn-success">View All</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-person fs-1 text-info"></i>
                    <h5 class="card-title mt-3">My Profile</h5>
                    <p class="card-text">Update your personal information</p>
                    <a asp-action="Profile" class="btn btn-info">View Profile</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card text-center shadow-sm bg-light">
                <div class="card-body">
                    <i class="bi bi-calendar3 fs-1 text-primary"></i>
                    <h5 class="card-title mt-3">Calendar View</h5>
                    <p class="card-text">View all your appointments in a calendar</p>
                    <a asp-action="Calendar" class="btn btn-primary">
                        <i class="bi bi-calendar3"></i> Open Calendar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Recent Appointments</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.Appointments != null && ViewBag.Appointments.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Date & Time</th>
                                        <th>Doctor</th>
                                        <th>Specialization</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in ViewBag.Appointments)
                                    {
                                        <tr>
                                            <td>@appointment.TimeSlot.StartDateTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                                            <td>Dr. @appointment.Doctor.User.FirstName @appointment.Doctor.User.LastName</td>
                                            <td>@appointment.Doctor.Specialization.Name</td>
                                            <td>
                                                @if (appointment.AppointmentStatus.StatusName == "Pending")
                                                {
                                                    <span class="badge bg-warning">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                                else if (appointment.AppointmentStatus.StatusName == "Approved")
                                                {
                                                    <span class="badge bg-success">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                                else if (appointment.AppointmentStatus.StatusName == "Completed")
                                                {
                                                    <span class="badge bg-info">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-outline-primary">View Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x fs-1 text-muted"></i>
                            <p class="mt-3 text-muted">No appointments yet. Book your first appointment!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
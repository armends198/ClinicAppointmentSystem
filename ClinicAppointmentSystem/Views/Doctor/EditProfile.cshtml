@model ClinicAppointmentSystem.ViewModels.EditDoctorProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-person-gear"></i> Edit My Profile</h2>
                <div>
                    <a asp-action="Profile" class="btn btn-secondary">Cancel</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Update Your Professional Information</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditProfile" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Personal Information -->
                        <h6 class="border-bottom pb-2 mb-3">Personal Information</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- Professional Information -->
                        <h6 class="border-bottom pb-2 mb-3 mt-4">Professional Information</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SpecializationId" class="form-label"></label>
                                <select asp-for="SpecializationId" class="form-select">
                                    <option value="">-- Select Specialization --</option>
                                    @foreach (var spec in ViewBag.Specializations)
                                    {
                                        <option value="@spec.SpecializationId">@spec.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="SpecializationId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LicenseNumber" class="form-label"></label>
                                <input asp-for="LicenseNumber" class="form-control" />
                                <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Biography" class="form-label"></label>
                            <textarea asp-for="Biography" class="form-control" rows="4"
                                      placeholder="Tell patients about your experience, education, and expertise..."></textarea>
                            <span asp-validation-for="Biography" class="text-danger"></span>
                        </div>

                        <!-- Consultation Details -->
                        <h6 class="border-bottom pb-2 mb-3 mt-4">Consultation Details</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConsultationDuration" class="form-label"></label>
                                <input asp-for="ConsultationDuration" type="number" class="form-control" min="15" max="120" />
                                <span asp-validation-for="ConsultationDuration" class="text-danger"></span>
                                <small class="text-muted">Time in minutes per appointment</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConsultationFee" class="form-label"></label>
                                <input asp-for="ConsultationFee" type="number" step="0.01" class="form-control" min="0" />
                                <span asp-validation-for="ConsultationFee" class="text-danger"></span>
                                <small class="text-muted">Consultation fee in dollars</small>
                            </div>
                        </div>

                        <div class="alert alert-warning mt-3">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Note:</strong> Changing consultation duration will not affect existing time slots.
                            You'll need to regenerate time slots for the new duration to take effect.
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                            <a asp-action="Profile" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model ClinicAppointmentSystem.ViewModels.ManageScheduleViewModel

@using ClinicAppointmentSystem.Helpers

@{
    ViewData["Title"] = "Manage Schedule";
    var daysOfWeek = EnumHelper.GetDaysOfWeek();
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-calendar-week"></i> Manage My Schedule</h2>
                <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Add New Working Hours -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Add Working Hours</h5>
                </div>
                <div class="card-body">
                    <form asp-action="AddWorkingHours" method="post">
                        <div class="mb-3">
                            <label asp-for="NewSchedule.DayOfWeek" class="form-label"></label>
                            <select asp-for="NewSchedule.DayOfWeek" class="form-select">
                                <option value="">-- Select Day --</option>
                                <option value="1">Monday</option>
                                <option value="2">Tuesday</option>
                                <option value="3">Wednesday</option>
                                <option value="4">Thursday</option>
                                <option value="5">Friday</option>
                                <option value="6">Saturday</option>
                                <option value="0">Sunday</option>
                            </select>
                            <span asp-validation-for="NewSchedule.DayOfWeek" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewSchedule.StartTimeString" class="form-label">Start Time</label>
                            <input asp-for="NewSchedule.StartTimeString" type="time" class="form-control" />
                            <span asp-validation-for="NewSchedule.StartTimeString" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewSchedule.EndTimeString" class="form-label">End Time</label>
                            <input asp-for="NewSchedule.EndTimeString" type="time" class="form-control" />
                            <span asp-validation-for="NewSchedule.EndTimeString" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="NewSchedule.IsActive" type="checkbox" class="form-check-input" checked />
                            <label asp-for="NewSchedule.IsActive" class="form-check-label"></label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Add Schedule
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Tips</h6>
                </div>
                <div class="card-body">
                    <small>
                        <ul class="mb-0">
                            <li>Set your available working hours for each day</li>
                            <li>You can add multiple time slots per day</li>
                            <li>Patients can only book during these hours</li>
                            <li>Make sure times don't overlap</li>
                        </ul>
                    </small>
                </div>
            </div>
        </div>

        <!-- Current Schedule -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-calendar3"></i> Current Schedule</h5>
                </div>
                <div class="card-body">
                    @if (Model.ExistingSchedule != null && Model.ExistingSchedule.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Day</th>
                                        <th>Start Time</th>
                                        <th>End Time</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var schedule in Model.ExistingSchedule)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@daysOfWeek[schedule.DayOfWeek]</strong>
                                            </td>
                                            <td>@schedule.StartTime.ToString(@"hh\:mm")</td>
                                            <td>@schedule.EndTime.ToString(@"hh\:mm")</td>
                                            <td>
                                                @if (schedule.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <form asp-action="DeleteWorkingHours" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this schedule?');">
                                                    <input type="hidden" name="id" value="@schedule.WorkingHoursId" />
                                                    <button type="submit" class="btn btn-sm btn-danger">
                                                        <i class="bi bi-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Weekly View -->
                        <hr class="my-4" />
                        <h6>Weekly Overview</h6>
                        <div class="row">
                            @foreach (var day in daysOfWeek.OrderBy(d => d.Key == 0 ? 7 : d.Key))
                            {
                                var daySchedules = Model.ExistingSchedule.Where(s => s.DayOfWeek == day.Key && s.IsActive).ToList();
                                <div class="col-md-6 mb-3">
                                    <div class="card @(daySchedules.Any() ? "border-success" : "border-secondary")">
                                        <div class="card-body">
                                            <h6 class="card-title">@day.Value</h6>
                                            @if (daySchedules.Any())
                                            {
                                                foreach (var schedule in daySchedules)
                                                {
                                                    <div class="badge bg-success me-1 mb-1">
                                                        @schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <small class="text-muted">No schedule set</small>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x fs-1 text-muted"></i>
                            <p class="mt-3 text-muted">No working hours set yet. Add your first schedule to get started!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
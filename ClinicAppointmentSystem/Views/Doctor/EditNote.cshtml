@model ClinicAppointmentSystem.Models.DoctorNote

@{
    ViewData["Title"] = "Edit Doctor Note";
    var appointment = ViewBag.Appointment as ClinicAppointmentSystem.Models.Appointment;
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Edit Doctor Note</h2>
            <p class="text-muted">Update medical notes for this appointment</p>
        </div>
    </div>

    @if (appointment != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Appointment Details</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Patient:</strong> @appointment.Patient.User.FirstName @appointment.Patient.User.LastName</p>
                        <p><strong>Date:</strong> @appointment.TimeSlot.StartDateTime.ToString("MMMM dd, yyyy")</p>
                        <p><strong>Time:</strong> @appointment.TimeSlot.StartDateTime.ToString("hh:mm tt") - @appointment.TimeSlot.EndDateTime.ToString("hh:mm tt")</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Reason for Visit:</strong> @appointment.Reason</p>
                        <p><strong>Blood Type:</strong> @appointment.Patient.BloodType</p>
                        <p><strong>Allergies:</strong> @(string.IsNullOrEmpty(appointment.Patient.Allergies) ? "None" : appointment.Patient.Allergies)</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="EditNote" method="post">
                <input type="hidden" asp-for="NoteId" />
                <input type="hidden" asp-for="AppointmentId" />

                <div class="mb-3">
                    <label asp-for="Diagnosis" class="form-label">Diagnosis <span class="text-danger">*</span></label>
                    <textarea asp-for="Diagnosis" class="form-control" rows="3" required></textarea>
                    <span asp-validation-for="Diagnosis" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Treatment" class="form-label">Treatment <span class="text-danger">*</span></label>
                    <textarea asp-for="Treatment" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="Treatment" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Prescription" class="form-label">Prescription</label>
                    <textarea asp-for="Prescription" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Prescription" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AdditionalNotes" class="form-label">Additional Notes</label>
                    <textarea asp-for="AdditionalNotes" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="AdditionalNotes" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Update Note
                    </button>
                    <a asp-action="ViewNote" asp-route-appointmentId="@Model.AppointmentId" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
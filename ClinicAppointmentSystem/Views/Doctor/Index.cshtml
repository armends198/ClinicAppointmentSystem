@{
    ViewData["Title"] = "Doctor Dashboard";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <h2>Welcome, @ViewBag.DoctorName!</h2>
            <p class="text-muted">@ViewBag.Specialization</p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm bg-primary text-white">
                <div class="card-body">
                    <i class="bi bi-calendar-check fs-1"></i>
                    <h3 class="mt-3">@ViewBag.TodayAppointments.Count</h3>
                    <p class="card-text">Today's Appointments</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm bg-success text-white">
                <div class="card-body">
                    <i class="bi bi-clock-history fs-1"></i>
                    <h3 class="mt-3">@ViewBag.UpcomingAppointments.Count</h3>
                    <p class="card-text">Upcoming Appointments</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm bg-info text-white">
                <div class="card-body">
                    <i class="bi bi-people fs-1"></i>
                    <h3 class="mt-3">@ViewBag.TotalAppointments</h3>
                    <p class="card-text">Total Appointments</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-calendar-week fs-1 text-primary"></i>
                    <h6 class="card-title mt-3">My Schedule</h6>
                    <a asp-action="ManageSchedule" class="btn btn-sm btn-primary">View Schedule</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-calendar-check fs-1 text-success"></i>
                    <h6 class="card-title mt-3">Appointments</h6>
                    <a asp-action="Appointments" class="btn btn-sm btn-success">Manage</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-file-medical fs-1 text-info"></i>
                    <h6 class="card-title mt-3">Patient Records</h6>
                    <a href="#" class="btn btn-sm btn-info">View Records</a>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <i class="bi bi-person fs-1 text-warning"></i>
                    <h6 class="card-title mt-3">My Profile</h6>
                    <a asp-action="Profile" class="btn btn-sm btn-warning">View Profile</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Calendar View -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card text-center shadow-sm bg-light">
                <div class="card-body">
                    <i class="bi bi-calendar3 fs-1 text-success"></i>
                    <h5 class="card-title mt-3">Calendar View</h5>
                    <p class="card-text">View all your appointments in a calendar</p>
                    <a asp-action="Calendar" class="btn btn-success">
                        <i class="bi bi-calendar3"></i> Open Calendar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Appointments -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Today's Appointments</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.TodayAppointments != null && ViewBag.TodayAppointments.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Time</th>
                                        <th>Patient</th>
                                        <th>Reason</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in ViewBag.TodayAppointments)
                                    {
                                        <tr>
                                            <td>@appointment.TimeSlot.StartDateTime.ToString("hh:mm tt")</td>
                                            <td>@appointment.Patient.User.FirstName @appointment.Patient.User.LastName</td>
                                            <td>@(appointment.Reason ?? "Not specified")</td>
                                            <td>
                                                @if (appointment.AppointmentStatus.StatusName == "Pending")
                                                {
                                                    <span class="badge bg-warning">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                                else if (appointment.AppointmentStatus.StatusName == "Approved")
                                                {
                                                    <span class="badge bg-success">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                                else if (appointment.AppointmentStatus.StatusName == "Completed")
                                                {
                                                    <span class="badge bg-info">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-outline-primary">View Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x fs-1 text-muted"></i>
                            <p class="mt-3 text-muted">No appointments scheduled for today.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Appointments -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Upcoming Appointments</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.UpcomingAppointments != null && ViewBag.UpcomingAppointments.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Date & Time</th>
                                        <th>Patient</th>
                                        <th>Reason</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in ViewBag.UpcomingAppointments)
                                    {
                                        <tr>
                                            <td>@appointment.TimeSlot.StartDateTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                                            <td>@appointment.Patient.User.FirstName @appointment.Patient.User.LastName</td>
                                            <td>@(appointment.Reason ?? "Not specified")</td>
                                            <td>
                                                @if (appointment.AppointmentStatus.StatusName == "Pending")
                                                {
                                                    <span class="badge bg-warning">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                                else if (appointment.AppointmentStatus.StatusName == "Approved")
                                                {
                                                    <span class="badge bg-success">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@appointment.AppointmentStatus.StatusName</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="#" class="btn btn-sm btn-outline-primary">View Details</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x fs-1 text-muted"></i>
                            <p class="mt-3 text-muted">No upcoming appointments.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
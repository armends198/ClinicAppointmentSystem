@model ClinicAppointmentSystem.Models.Doctor

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>My Profile</h2>
                <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Professional Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">First Name:</label>
                            <p>@Model.User.FirstName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Last Name:</label>
                            <p>@Model.User.LastName</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email:</label>
                            <p>@Model.User.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Phone Number:</label>
                            <p>@(Model.User.PhoneNumber ?? "Not provided")</p>
                        </div>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Specialization:</label>
                            <p><span class="badge bg-primary">@Model.Specialization.Name</span></p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">License Number:</label>
                            <p>@Model.LicenseNumber</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Consultation Duration:</label>
                            <p>@Model.ConsultationDuration minutes</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Consultation Fee:</label>
                            <p>$@Model.ConsultationFee.ToString("0.00")</p>
                        </div>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Biography:</label>
                            <p>@(Model.Biography ?? "No biography provided")</p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-action="EditProfile" class="btn btn-success">
                            <i class="bi bi-pencil"></i> Edit Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Index" class="btn btn-outline-primary">Dashboard</a>
                        <a href="#" class="btn btn-outline-success">My Schedule</a>
                        <a href="#" class="btn btn-outline-info">Appointments</a>
                        <a asp-action="Logout" asp-controller="Account" class="btn btn-outline-danger">Logout</a>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">Account Status</h6>
                </div>
                <div class="card-body">
                    <p><strong>Status:</strong> <span class="badge bg-success">Active</span></p>
                    <p><strong>Member Since:</strong> @Model.CreatedAt.ToString("MMMM yyyy")</p>
                    <p><strong>Specialization:</strong> @Model.Specialization.Name</p>
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0">Practice Details</h6>
                </div>
                <div class="card-body">
                    <p><strong>Appointment Duration:</strong><br>@Model.ConsultationDuration minutes</p>
                    <p><strong>Consultation Fee:</strong><br>$@Model.ConsultationFee.ToString("0.00")</p>
                </div>
            </div>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Welcome - Clinic Appointment System";
}

<div class="container mt-4">

    <!-- Hero Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-body text-center py-5">
            <i class="bi bi-hospital fs-1 text-primary mb-3"></i>
            <h1 class="display-5 fw-bold">Clinic Appointment System</h1>
            <p class="lead text-muted mb-4">Book appointments with qualified doctors, manage your health records, and take control of your healthcare journey.</p>

            @if (Context.Session.GetString("UserName") == null)
            {
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg">
                        <i class="bi bi-person-plus"></i> Get Started
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                </div>
            }
            else
            {
                @if (Context.Session.GetString("UserRole") == "Patient")
                {
                    <a asp-controller="Patient" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-speedometer2"></i> Go to Dashboard
                    </a>
                }
                else if (Context.Session.GetString("UserRole") == "Doctor")
                {
                    <a asp-controller="Doctor" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-speedometer2"></i> Go to Dashboard
                    </a>
                }
                else if (Context.Session.GetString("UserRole") == "Admin")
                {
                    <a asp-controller="Admin" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-speedometer2"></i> Go to Dashboard
                    </a>
                }
            }
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm bg-primary text-white">
                <div class="card-body">
                    <i class="bi bi-people fs-1"></i>
                    <h3 class="mt-2">50+</h3>
                    <p class="mb-0">Expert Doctors</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm bg-success text-white">
                <div class="card-body">
                    <i class="bi bi-person-heart fs-1"></i>
                    <h3 class="mt-2">1000+</h3>
                    <p class="mb-0">Happy Patients</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card text-center shadow-sm bg-info text-white">
                <div class="card-body">
                    <i class="bi bi-clipboard2-pulse fs-1"></i>
                    <h3 class="mt-2">15+</h3>
                    <p class="mb-0">Specializations</p>
                </div>
            </div>
        </div>
    </div>

    <!-- How It Works -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-info-circle"></i> How It Works</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-person-plus fs-3 text-primary"></i>
                    </div>
                    <h6 class="fw-bold">1. Create Account</h6>
                    <p class="text-muted small">Register as a patient or doctor with your basic information.</p>
                </div>
                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-search fs-3 text-success"></i>
                    </div>
                    <h6 class="fw-bold">2. Find a Doctor</h6>
                    <p class="text-muted small">Browse specialists and choose the right one for you.</p>
                </div>
                <div class="col-md-4 text-center">
                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                        <i class="bi bi-calendar-check fs-3 text-info"></i>
                    </div>
                    <h6 class="fw-bold">3. Book Appointment</h6>
                    <p class="text-muted small">Select a time slot and confirm your appointment.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Specializations -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0"><i class="bi bi-grid"></i> Our Specializations</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <div class="card text-center h-100">
                        <div class="card-body p-3">
                            <i class="bi bi-heart-pulse fs-2 text-danger"></i>
                            <p class="mb-0 mt-2 small">Cardiology</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <div class="card text-center h-100">
                        <div class="card-body p-3">
                            <i class="bi bi-brightness-high fs-2 text-warning"></i>
                            <p class="mb-0 mt-2 small">Dermatology</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <div class="card text-center h-100">
                        <div class="card-body p-3">
                            <i class="bi bi-emoji-smile fs-2 text-info"></i>
                            <p class="mb-0 mt-2 small">Pediatrics</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <div class="card text-center h-100">
                        <div class="card-body p-3">
                            <i class="bi bi-bandaid fs-2 text-success"></i>
                            <p class="mb-0 mt-2 small">Orthopedics</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <div class="card text-center h-100">
                        <div class="card-body p-3">
                            <i class="bi bi-clipboard2-pulse fs-2 text-primary"></i>
                            <p class="mb-0 mt-2 small">General</p>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4 col-lg-2 mb-3">
                    <div class="card text-center h-100">
                        <div class="card-body p-3">
                            <i class="bi bi-plus-circle fs-2 text-secondary"></i>
                            <p class="mb-0 mt-2 small">More...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Register Options -->
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body text-center p-4">
                    <i class="bi bi-person-heart fs-1 text-primary mb-3"></i>
                    <h5 class="card-title">For Patients</h5>
                    <p class="card-text text-muted">Book appointments, manage your health records, and connect with doctors.</p>
                    <a asp-controller="Account" asp-action="RegisterPatient" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Register as Patient
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body text-center p-4">
                    <i class="bi bi-hospital fs-1 text-success mb-3"></i>
                    <h5 class="card-title">For Doctors</h5>
                    <p class="card-text text-muted">Manage your schedule, view appointments, and provide medical care.</p>
                    <a asp-controller="Account" asp-action="RegisterDoctor" class="btn btn-success">
                        <i class="bi bi-person-plus"></i> Register as Doctor
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Contact Info -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-telephone"></i> Contact Us</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-geo-alt fs-4 text-primary me-3"></i>
                        <div>
                            <strong>Location</strong>
                            <p class="mb-0 text-muted small">123 Medical Center Drive</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-telephone fs-4 text-primary me-3"></i>
                        <div>
                            <strong>Phone</strong>
                            <p class="mb-0 text-muted small">+1 (555) 123-4567</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-envelope fs-4 text-primary me-3"></i>
                        <div>
                            <strong>Email</strong>
                            <p class="mb-0 text-muted small">contact@clinicsystem.com</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>